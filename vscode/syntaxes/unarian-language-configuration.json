{
    "comments": {
        "lineComment": { "comment": "#", "noIndent": false }
    },
    "brackets": [
        ["{", "}"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}", "notIn": ["comment"] }
    ],
    "surroundingPairs": [
        ["{", "}"]
    ],
    "folding": {
        "markers": {
            "start": "(?<!\\S)\\{\\s*$",
            "end": "^\\s*\\}(?!\\S)"
        }
    },
    "indentationRules": {
        "increaseIndentPattern": "(?<!\\S)\\{\\s*$",
        "decreaseIndentPattern": "^\\s*\\}(?!\\S)"
    },
    "wordPattern": "([^\\s#]{2,}|[^\\s#{|}])"
}